#http://localhost:4004/odata/v4/main/SalesOrderHeaders?$filter=totalAmount%20le%203768.44
############################################
GET {{baseUrl}}/SalesOrderHeaders?filter=id eq {{id}}&$expand=items
Content-Type: application/json

###
GET {{baseUrl}}/SalesOrderHeaders?$filter=totalAmount ge 3768.44
